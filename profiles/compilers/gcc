{% set gcc_version = "11" %}

[settings]
compiler=gcc
compiler.version={{ gcc_version }}
compiler.cppstd=20
compiler.libcxx=libstdc++11

[buildenv]
# Ensure that the right version of gcc is picked up by cmake instead of any version installed on the system:
CC=gcc-{{ gcc_version }}
CXX=g++-{{ gcc_version }}
