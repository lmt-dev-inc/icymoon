{
    // CMake: use the CMake from .venv and the Conan-generated presets
    "cmake.cmakePath": "${workspaceFolder}/.venv/bin/cmake",
    "cmake.useCMakePresets": "always",
    // Python: use .venv for dev.py and activate it in new terminals
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.typeCheckingMode": "standard",
    // C++ IntelliSense: include paths and defines come from the active CMake preset
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.associations": {
        "*.rgen": "glsl",
        "*.rchit": "glsl",
        "*.rmiss": "glsl",
        "*.rint": "glsl"
    }
}